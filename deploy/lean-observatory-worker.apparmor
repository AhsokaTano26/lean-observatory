# SPDX-License-Identifier: Apache-2.0
# Container restrictions informed by the Moby default profile (Apache-2.0):
# https://github.com/moby/profiles/blob/main/apparmor/template.go
# Unlike docker-default, permit only the private proc mount required by unshare.
abi <abi/3.0>,
#include <tunables/global>

profile lean-observatory-worker flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,

  # util-linux unshare makes its newly created mount namespace private, then
  # mounts proc for its private PID namespace. No general mount permission.
  mount options=(rw, rprivate) -> /,
  mount options=(rw, rprivate) -> /sandbox/proc/,
  mount fstype=proc -> /sandbox/proc/,
  umount /sandbox/proc/,

  deny /proc/sys/** w,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /sandbox/proc/sys/** w,
  deny /sandbox/proc/sysrq-trigger rwklx,
  deny /sandbox/proc/kcore rwklx,
  deny /sys/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  signal (receive),
  signal (send) peer=lean-observatory-worker,
  signal (send) peer=lean-observatory-worker//&unconfined,
  ptrace (trace,tracedby,read,readby) peer=lean-observatory-worker,
  ptrace (trace,tracedby,read,readby) peer=lean-observatory-worker//&unconfined,
}
